# Region-specific Nabla Connect server URL (e.g. https://us.api.nabla.com/v1/connect/server, https://eu.api.nabla.com/v1/connect/server).
# Do NOT use https://api.nabla.com — it is no longer supported.
NABLA_URL=https://<region>.api.nabla.com/v1/connect/server
NABLA_API_VERSION=2026-03-23

# Shared secret used to sign callback requests (HMAC)
NABLA_SIGNATURE_SECRET=

# Default provider info used when launching encounters
DEFAULT_PROVIDER_ID=prov-123456
DEFAULT_PROVIDER_EMAIL=

# OAuth client credentials
OAUTH_CLIENT_ID=
OAUTH_PRIVATE_KEY=

# OAuth client-credentials auth for the Connect callback (optional).
# When set, the app serves a token endpoint at POST /oauth/token and requires
# a matching bearer token on POST /nabla/callback. Configure the same values
# in Nabla (updateNablaConnectConfiguration.oauthClientCredentials).
CALLBACK_OAUTH_CLIENT_ID=
CALLBACK_OAUTH_CLIENT_SECRET=

# Port for the local HTTP server
PORT=4000
